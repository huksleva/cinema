КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПродажи(Команда)
	Попытка
		ОткрытьФорму("Отчет.Продажи.Форма");
	Исключение
		ПоказатьОповещениеПользователя("Отчет", , "Отчет 'Продажи'");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетОстатки(Команда)
	Попытка
		ОткрытьФорму("Отчет.Остатки.Форма");
	Исключение
		ПоказатьОповещениеПользователя("Отчет", , "Отчет 'Остатки товаров'");
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиНаСервере()
	// 1. Получаем остатки через параметр &Период
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(ОстаткиОстатки.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Период, ) КАК ОстаткиОстатки
	|		ПО СпрНоменклатура.Ссылка = ОстаткиОстатки.Номенклатура";
	ЗапросОстатки.УстановитьПараметр("Период", ТекущаяДата());
	
	Попытка
		ВыборкаОстатки = ЗапросОстатки.Выполнить().Выбрать();
		Пока ВыборкаОстатки.Следующий() Цикл
			ИмяТовара = ВРег(ВыборкаОстатки.Номенклатура.Наименование);
			Если Найти(ИмяТовара, "ПОПКОРН") > 0 Тогда
				ОстатокПопкорна = ВыборкаОстатки.Количество;
			ИначеЕсли Найти(ИмяТовара, "НАПИТОК") > 0 Тогда
				ОстатокНапитков = ВыборкаОстатки.Количество;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 2. Получаем общую выручку кинотеатра
	ЗапросПродажи = Новый Запрос;
	ЗапросПродажи.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Продажи.Сумма), 0) КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи";
	
	Попытка
		ВыборкаПродажи = ЗапросПродажи.Выполнить().Выбрать();
		Если ВыборкаПродажи.Следующий() Тогда
			ВыручкаСегодня = ВыборкаПродажи.Выручка;
		КонецЕсли;
	Исключение
		ЗапросПродажи2 = Новый Запрос;
		ЗапросПродажи2.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Продажи.Стоимость), 0) КАК Выручка
		|ИЗ
		|	РегистрНакопления.Продажи КАК Продажи";
		Попытка
			Выборка2 = ЗапросПродажи2.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда
				ВыручкаСегодня = Выборка2.Выручка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры
