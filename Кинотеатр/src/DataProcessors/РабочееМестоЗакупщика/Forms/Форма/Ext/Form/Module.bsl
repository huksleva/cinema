	ПоказатьОповещениеПользователя("Обновлено", , "Остатки склада актуальны");
КонецПроцедуры

&НаСервере
Процедура ОформитьПоставкуНаСервере(ИмяТовара, КолВо, ЦенаЗакупки)
	Док = Документы.Приход.СоздатьДокумент();
	Док.Дата = ТекущаяДата();
	Док.Организация = Справочники.Организации.НайтиПоНаименованию("Кинотеатр Премьера");
	
	ИмяТЧ = "Товары";
	Попытка
		Тест = Док[ИмяТЧ];
	Исключение
		Попытка
			ИмяТЧ = "Номенклатура";
			Тест = Док[ИмяТЧ];
		Исключение
			ИмяТЧ = "Состав";
		КонецПопытки;
	КонецПопытки;
	
	НоваяСтр = Док[ИмяТЧ].Добавить();
	НоваяСтр.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
	НоваяСтр.Количество   = КолВо;
	НоваяСтр.Цена         = ЦенаЗакупки;
	НоваяСтр.Сумма        = КолВо * ЦенаЗакупки;
	
	// Было: при ошибке проведения документ молча записывался черновиком, а оператор видел «Поступило на склад»
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиНаСервере()
	ОстаткиСклада.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(ОстаткиОстатки.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Период, ) КАК ОстаткиОстатки
	|		ПО СпрНоменклатура.Ссылка = ОстаткиОстатки.Номенклатура";
	// Было: несуществующий регистр «Остатки» и ТекущаяДата() внутри текста запроса, ошибка глушилась и таблица оставалась пустой
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
		Для Каждого Стр Из Результат Цикл
			НовСтр = ОстаткиСклада.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Количество   = Стр.Количество;
		КонецЦикла;
	Исключение
		Сообщить("Не удалось получить остатки: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры