Процедура ПриНачалеРаботыСистемы()
    Если СтрНачинаетсяС(ПараметрЗапуска, "Smoke|") Тогда
        Лог = Новый Массив;
        Для Каждого ИмяФормы Из СтрРазделить("ОбщаяФорма.РабочееМесто,Справочник.Номенклатура.Форма.ФормаЭлемента,Документ.Приход.Форма.ФормаДокумента,Документ.Расход.Форма.ФормаДокумента,Отчет.Остатки.Форма.ФормаОтчета,Отчет.Продажи.Форма.ФормаОтчета", ",") Цикл
            Попытка
                ФормаПроверки = ПолучитьФорму(ИмяФормы);
                ФормаПроверки.Открыть();
                Лог.Добавить("PASS " + ИмяФормы);
                ФормаПроверки.Закрыть();
            Исключение
                Лог.Добавить("FAIL " + ИмяФормы + " " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        Попытка
            ФормаПроверки = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", КинотеатрСервер.ДемоТовар()), , "ФотоТест");
            ФормаПроверки.Открыть();
            Если ПустаяСтрока(ФормаПроверки.АдресФото) Тогда ВызватьИсключение "Нет адреса фотографии"; КонецЕсли;
            Лог.Добавить("PASS Фотография сохраненного товара передана в поле картинки");
            ФормаПроверки.Закрыть();
        Исключение
            Лог.Добавить("FAIL Фотография " + ОписаниеОшибки() + "; байт в базе: " + Строка(КинотеатрСервер.РазмерДемоФото()));
        КонецПопытки;
        КинотеатрСервер.ЗаписатьТекстЛога(Сред(ПараметрЗапуска, 7), СтрСоединить(Лог, Символы.ПС));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "SelfTest|") Тогда
        КинотеатрСервер.ЗаписатьРезультатТестов(Сред(ПараметрЗапуска, 10));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "Init|") Тогда
        КинотеатрСервер.ЗаполнитьДемо();
        КинотеатрСервер.ЗагрузитьДемоФото(Сред(ПараметрЗапуска, 6));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли ПараметрЗапуска = "Demo" Тогда
        КинотеатрСервер.ЗаполнитьДемо();
    Иначе
        ОткрытьФорму("ОбщаяФорма.РабочееМесто");
    КонецЕсли;
КонецПроцедуры

