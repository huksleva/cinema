Процедура ПриНачалеРаботыСистемы()
    Если СтрНачинаетсяС(ПараметрЗапуска, "Smoke|") Тогда
        Лог = Новый Массив;
        Для Каждого ИмяФормы Из СтрРазделить("Справочник.Номенклатура.Форма.ФормаЭлемента,Документ.Приход.Форма.ФормаДокумента,Документ.Расход.Форма.ФормаДокумента,Отчет.Остатки.Форма.ФормаОтчета,Отчет.Продажи.Форма.ФормаОтчета", ",") Цикл
            Попытка
                ФормаПроверки = ПолучитьФорму(ИмяФормы);
                ФормаПроверки.Открыть();
                Если ИмяФормы = "Документ.Расход.Форма.ФормаДокумента" Тогда
                    Если НЕ ЗначениеЗаполнено(ФормаПроверки.Объект.Организация)
                        Или НЕ ЗначениеЗаполнено(ФормаПроверки.Объект.Покупатель) Тогда
                        ВызватьИсключение "Не подставились организация и розничный покупатель";
                    КонецЕсли;
                КонецЕсли;
                Если ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
                    Если НЕ ЗначениеЗаполнено(КинотеатрСервер.ЕдиницаИзмеренияЕсть("шт")) Тогда
                        ВызватьИсключение "Не создана базовая единица измерения";
                    КонецЕсли;
                КонецЕсли;
                Лог.Добавить("PASS " + ИмяФормы);
                ФормаПроверки.Закрыть();
            Исключение
                Лог.Добавить("FAIL " + ИмяФормы + " " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        Для Каждого РежимПроверки Из СтрРазделить("bar,tickets", ",") Цикл
            Попытка
                ПараметрыКассы = Новый Структура("РежимКассы", РежимПроверки);
                ФормаКассы = ПолучитьФорму("Обработка.РабочееМестоКассира.Форма", ПараметрыКассы, , "SmokeКасса" + РежимПроверки);
                ФормаКассы.Открыть();
                Если ФормаКассы.РежимКассы <> РежимПроверки Тогда
                    ВызватьИсключение "Рабочее место проигнорировало параметр режима кассы";
                КонецЕсли;
                Лог.Добавить("PASS Режим кассы: " + РежимПроверки);
                ФормаКассы.Закрыть();
            Исключение
                Лог.Добавить("FAIL Режим кассы " + РежимПроверки + " " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        Попытка
            ФормаПроверки = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", КинотеатрСервер.ДемоТовар()), , "ФотоТест");
            ФормаПроверки.Открыть();
            Если ПустаяСтрока(ФормаПроверки.АдресФото) Тогда ВызватьИсключение "Нет адреса фотографии"; КонецЕсли;
            Лог.Добавить("PASS Фотография сохраненного товара передана в поле картинки");
            ФормаПроверки.Закрыть();
        Исключение
            Лог.Добавить("FAIL Фотография " + ОписаниеОшибки() + "; байт в базе: " + Строка(КинотеатрСервер.РазмерДемоФото()));
        КонецПопытки;
        КинотеатрСервер.ЗаписатьТекстЛога(Сред(ПараметрЗапуска, 7), СтрСоединить(Лог, Символы.ПС));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "SelfTest|") Тогда
        КинотеатрСервер.ЗаписатьРезультатТестов(Сред(ПараметрЗапуска, 10));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли СтрНачинаетсяС(ПараметрЗапуска, "Init|") Тогда
        КинотеатрСервер.ЗаполнитьДемо();
        КинотеатрСервер.ЗагрузитьДемоФото(Сред(ПараметрЗапуска, 6));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли ПараметрЗапуска = "Demo" Тогда
        КинотеатрСервер.ЗаполнитьДемо();
    КонецЕсли;
КонецПроцедуры

