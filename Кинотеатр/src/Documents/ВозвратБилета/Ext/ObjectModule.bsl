
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если НЕ ЭтоНовый() Тогда

        СтарыйДокумент = Ссылка.ПолучитьОбъект();

        Если СтарыйДокумент.Проведен Тогда

            Если СтарыйДокумент.Продажа <> Продажа Тогда

                Сообщить("Нельзя изменять продажу в проведённом возврате!");
                Отказ = Истина;
                Возврат;

            КонецЕсли;

        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // Проверяем выбранную продажу
    Если НЕ ЗначениеЗаполнено(Продажа) Тогда

        Сообщить("Выбери продажу для возврата!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    ДокументПродажи = Продажа.ПолучитьОбъект();

    Если НЕ ДокументПродажи.Проведен Тогда

        Сообщить("Нельзя вернуть непроведённую продажу!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ДокументПродажи.Сеанс)
        Или НЕ ЗначениеЗаполнено(ДокументПродажи.Место) Тогда

        Сообщить("В продаже не указан сеанс или место!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если ДокументПродажи.Сеанс.ДатаНачала <= ТекущаяДата() Тогда

        Сообщить("Нельзя вернуть билет после начала сеанса!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    // Блокируем место на время возврата
    Блокировка = Новый БлокировкаДанных;

    Элемент = Блокировка.Добавить("РегистрСведений.Билеты");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;

    Элемент.УстановитьЗначение(
        "Сеанс", ДокументПродажи.Сеанс);

    Элемент.УстановитьЗначение(
        "Место", ДокументПродажи.Место);

    Блокировка.Заблокировать();

    // Проверяем повторный возврат
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Возвраты.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ВозвратБилета КАК Возвраты
    |ГДЕ
    |   Возвраты.Продажа = &Продажа
    |   И Возвраты.Проведен
    |   И Возвраты.Ссылка <> &ТекущийДокумент";

    Запрос.УстановитьПараметр("Продажа", Продажа);
    Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

    Если НЕ Запрос.Выполнить().Пустой() Тогда

        Сообщить("По этому билету уже оформлен возврат!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    // Формируем движение возврата
    Движения.Билеты.Очистить();
    Движения.Билеты.Записывать = Истина;

    Движение = Движения.Билеты.Добавить();

    Движение.Сеанс = ДокументПродажи.Сеанс;
    Движение.Место = ДокументПродажи.Место;
    Движение.Статус = "Возвращено";
    Движение.Цена = ДокументПродажи.Цена;

    // Уникальный идентификатор операции возврата
    Движение.Операция = Строка(Ссылка.УникальныйИдентификатор());

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

    Если НЕ ЗначениеЗаполнено(Продажа) Тогда
        Возврат;
    КонецЕсли;

    ДокументПродажи = Продажа.ПолучитьОбъект();

    СеансБилета = ДокументПродажи.Сеанс;
    МестоБилета = ДокументПродажи.Место;

    Если НЕ ЗначениеЗаполнено(СеансБилета)
        Или НЕ ЗначениеЗаполнено(МестоБилета) Тогда
        Возврат;
    КонецЕсли;

    // Блокируем место
    Блокировка = Новый БлокировкаДанных;

    Элемент = Блокировка.Добавить("РегистрСведений.Билеты");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;

    Элемент.УстановитьЗначение("Сеанс", СеансБилета);
    Элемент.УстановитьЗначение("Место", МестоБилета);

    Блокировка.Заблокировать();

    // Ищем другие продажи этого места
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Продажи.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ПродажаБилета КАК Продажи
    |ГДЕ
    |   Продажи.Сеанс = &Сеанс
    |   И Продажи.Место = &Место
    |   И Продажи.Проведен
    |   И Продажи.Ссылка <> &ИсходнаяПродажа";

    Запрос.УстановитьПараметр("Сеанс", СеансБилета);
    Запрос.УстановитьПараметр("Место", МестоБилета);
    Запрос.УстановитьПараметр("ИсходнаяПродажа", Продажа);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        ЗапросВозврата = Новый Запрос;

        ЗапросВозврата.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   Возвраты.Ссылка КАК Ссылка
        |ИЗ
        |   Документ.ВозвратБилета КАК Возвраты
        |ГДЕ
        |   Возвраты.Продажа = &Продажа
        |   И Возвраты.Проведен";

        ЗапросВозврата.УстановитьПараметр(
            "Продажа", Выборка.Ссылка);

        Если ЗапросВозврата.Выполнить().Пустой() Тогда

            Сообщить(
                "Нельзя отменить возврат: " +
                "место уже продано другому покупателю!");

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
