&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма);
    Для Каждого Имя Из СтрРазделить("Номер,Дата,Организация,Покупатель,Комментарий", ",") Цикл
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект." + Имя;
    КонецЦикла;
    Таблица = Элементы.Добавить("Товары", Тип("ТаблицаФормы"));
    Таблица.ПутьКДанным = "Объект.Товары";
    Таблица.ЦветФона = Новый Цвет(244, 240, 250);
    Для Каждого Имя Из СтрРазделить("Номенклатура,Количество,Цена,Сумма", ",") Цикл
        Поле = Элементы.Добавить("Товары" + Имя, Тип("ПолеФормы"), Таблица);
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект.Товары." + Имя;
        Если Имя = "Сумма" Тогда Поле.ТолькоПросмотр = Истина; КонецЕсли;
    КонецЦикла;
КонецПроцедуры
