Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	// Для розничной продажи снеков заранее выбираем организацию кинотеатра
	// и нейтрального розничного покупателя. Переданные значения сохраняем.
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = Справочники.Организации.НайтиПоНаименованию("Кинотеатр Премьера");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Покупатель) Тогда
		Покупатель = Справочники.Покупатели.НайтиПоНаименованию("Розничный покупатель");
	КонецЕсли;
КонецПроцедуры
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
        КинотеатрСервер.ПроверитьДокумент(ЭтотОбъект, Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    // Штатные проверки вашей конфигурации
    КинотеатрСервер.ПроверитьДокумент(ЭтотОбъект, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    
    КинотеатрСервер.ЗаблокироватьОстатки(Организация);
    
    // Включаем запись движений по всем регистрам
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.Продажи.Записывать = Истина;
    Движения.РезервыТоваров.Записывать = Истина;
    
    Движения.ОстаткиТоваров.Очистить();
    Движения.Продажи.Очистить();
    Движения.РезервыТоваров.Очистить();
    
    // Определяем: это продажа по брони или обычный чек кассы?
    ПродажаПоБрони = ЗначениеЗаполнено(ДокументОснование);
    Если ПродажаПоБрони Тогда
        Бронь = ДокументОснование.ПолучитьОбъект();
        Если Не Бронь.Проведен Или Бронь.Статус <> "Забронировано"
            Или Бронь.СрокБрони <= ТекущаяДата() Или Бронь.Организация <> Организация Тогда
            Сообщить("Бронь не действует или принадлежит другой организации"); Отказ = Истина; Возврат;
        КонецЕсли;
        ЗапросПродаж = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Проведен И ДокументОснование = &Бронь И Ссылка <> &Текущий");
        ЗапросПродаж.УстановитьПараметр("Бронь", ДокументОснование);
        ЗапросПродаж.УстановитьПараметр("Текущий", Ссылка);
        Если Не ЗапросПродаж.Выполнить().Пустой() Тогда
            Сообщить("Эта бронь уже продана"); Отказ = Истина; Возврат;
        КонецЕсли;
        БроньТовары = Бронь.Товары.Выгрузить(); БроньТовары.Свернуть("Номенклатура", "Количество");
        ПродажаТовары = Товары.Выгрузить(); ПродажаТовары.Свернуть("Номенклатура", "Количество");
        Если БроньТовары.Количество() <> ПродажаТовары.Количество() Тогда
            Сообщить("Состав продажи не совпадает с бронью"); Отказ = Истина; Возврат;
        КонецЕсли;
        Для Каждого СтрокаПродажи Из ПродажаТовары Цикл
            СтрокаБрони = БроньТовары.Найти(СтрокаПродажи.Номенклатура, "Номенклатура");
            Если СтрокаБрони = Неопределено Или СтрокаБрони.Количество <> СтрокаПродажи.Количество Тогда
                Сообщить("Состав продажи не совпадает с бронью"); Отказ = Истина; Возврат;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    // 1. ЕСЛИ ПРОДАЖА ОБЫЧНАЯ (без брони) — проверяем, чтобы не продать чужой резерв!
    Если Не ПродажаПоБрони Тогда
        
        ТаблицаТоваров = Товары.Выгрузить();
        ТаблицаТоваров.Свернуть("Номенклатура", "Количество");
        
        ЗапросРезерв = Новый Запрос;
        ЗапросРезерв.Текст = 
        "ВЫБРАТЬ
        |   Док.Номенклатура КАК Номенклатура,
        |   Док.Количество КАК Требуется
        |ПОМЕСТИТЬ ВТ_ТоварыДокумента
        |ИЗ
        |   &ТаблицаТоваров КАК Док
        |;
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   ВТ.Номенклатура КАК Номенклатура,
        |   ВТ.Номенклатура.Наименование КАК Наименование,
        |   ВТ.Требуется КАК Требуется,
        |   ЕСТЬNULL(Склад.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.КоличествоОстаток, 0) КАК Свободно
        |ИЗ
        |   ВТ_ТоварыДокумента КАК ВТ
        |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Организация = &Организация) КАК Склад
        |       ПО ВТ.Номенклатура = Склад.Номенклатура
        |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыТоваров.Остатки(&Момент, Организация = &Организация) КАК Резерв
        |       ПО ВТ.Номенклатура = Резерв.Номенклатура";
        
        ЗапросРезерв.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
        ЗапросРезерв.УстановитьПараметр("Момент", МоментВремени());
        ЗапросРезерв.УстановитьПараметр("Организация", Организация);
        
        Выборка = ЗапросРезерв.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Выборка.Свободно < Выборка.Требуется Тогда
                Сообщение = Новый СообщениеПользователю;
                Сообщение.Текст = "Товар «" + Выборка.Наименование + "» находится в брони! Свободно для продажи: " 
                    + Выборка.Свободно + " шт., запрошено: " + Выборка.Требуется + " шт.";
                Сообщение.Сообщить();
                Отказ = Истина;
            КонецЕсли;
        КонецЦикла;
        
        Если Отказ Тогда Возврат; КонецЕсли;
        
    КонецЕсли;
    
    // 2. ДВИЖЕНИЯ ПО РЕГИСТРАМ
    Для Каждого СтрокаТовара Из Товары Цикл
        
        // Физическое списание со склада
        Движение = Движения.ОстаткиТоваров.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Организация = Организация;
        Движение.Номенклатура = СтрокаТовара.Номенклатура;
        Движение.Количество = СтрокаТовара.Количество;
        
        // Фиксация выручки
        Продажа = Движения.Продажи.Добавить();
        Продажа.Период = Дата;
        Продажа.Организация = Организация;
        Продажа.Покупатель = Покупатель;
        Продажа.Номенклатура = СтрокаТовара.Номенклатура;
        Продажа.Количество = СтрокаТовара.Количество;
        Продажа.Сумма = СтрокаТовара.Сумма;
        
        // Если продали по брони — снимаем резерв (бронь выполнена)!
        Если ПродажаПоБрони Тогда
            ДвРезерв = Движения.РезервыТоваров.Добавить();
            ДвРезерв.ВидДвижения = ВидДвиженияНакопления.Расход;
            ДвРезерв.Период = Дата;
            ДвРезерв.Организация = Организация;
            ДвРезерв.Номенклатура = СтрокаТовара.Номенклатура;
            ДвРезерв.Количество = СтрокаТовара.Количество;
        КонецЕсли;
        
    КонецЦикла;
    
    Движения.ОстаткиТоваров.Записать();
    Если ПродажаПоБрони Тогда
        Движения.РезервыТоваров.Записать();
    КонецЕсли;
    
    // Проверка отрицательных остатков
    КинотеатрСервер.ПроверитьОстатки(Организация, Отказ);
    КинотеатрСервер.ПроверитьДоступность(Организация, Отказ);
    
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    // Платформа удаляет движения продажи, и резерв брони возвращается. Бронь снова становится действующей,
    // иначе она осталась бы «Выкуплено» с удержанным резервом, который не снимет ни регламентное задание, ни касса
    Если Не ЗначениеЗаполнено(ДокументОснование) Тогда Возврат; КонецЕсли;
    Бронь = ДокументОснование.ПолучитьОбъект();
    Если Бронь.Проведен И Бронь.Статус = "Выкуплено" Тогда
        Бронь.Статус = "Забронировано";
        Бронь.Записать(РежимЗаписиДокумента.Запись);
    КонецЕсли;
КонецПроцедуры
