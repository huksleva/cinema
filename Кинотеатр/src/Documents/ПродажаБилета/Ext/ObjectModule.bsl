Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если НЕ ЭтоНовый() Тогда

        СтарыйДокумент = Ссылка.ПолучитьОбъект();

        Если СтарыйДокумент.Проведен Тогда

            Если СтарыйДокумент.Сеанс <> Сеанс
                Или СтарыйДокумент.Место <> Место
                Или СтарыйДокумент.Бронь <> Бронь
                Или СтарыйДокумент.Цена <> Цена
                Или СтарыйДокумент.Покупатель <> Покупатель Тогда

                Сообщить("Нельзя изменять проведённый билет! Оформи возврат и новую продажу.");
                Отказ = Истина;
                Возврат;

            КонецЕсли;

        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если НЕ ЗначениеЗаполнено(Сеанс)
        Или НЕ ЗначениеЗаполнено(Место) Тогда

        Сообщить("Выбери сеанс и место!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если Место.Зал <> Сеанс.Зал Тогда
        Сообщить("Место не принадлежит залу сеанса!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если Сеанс.ДатаНачала <= ТекущаяДата() Тогда
        Сообщить("Нельзя продать билет на начавшийся сеанс!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если Цена <= 0 Тогда
        Сообщить("Цена билета должна быть больше нуля!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если ЗначениеЗаполнено(Бронь) Тогда

        ДокументБрони = Бронь.ПолучитьОбъект();

        Если НЕ ДокументБрони.Проведен Тогда
            Сообщить("Бронь не проведена!");
            Отказ = Истина;
            Возврат;
        КонецЕсли;

        Если ДокументБрони.Сеанс <> Сеанс
            Или ДокументБрони.Место <> Место Тогда

            Сообщить("Бронь относится к другому месту или сеансу!");
            Отказ = Истина;
            Возврат;

        КонецЕсли;

        Если ДокументБрони.ДействуетДо <= ТекущаяДата() Тогда
            Сообщить("Срок брони истёк!");
            Отказ = Истина;
            Возврат;
        КонецЕсли;

        Запрос = Новый Запрос;

        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   Продажи.Ссылка КАК Ссылка
        |ИЗ
        |   Документ.ПродажаБилета КАК Продажи
        |ГДЕ
        |   Продажи.Бронь = &Бронь
        |   И Продажи.Проведен
        |   И Продажи.Ссылка <> &ТекущийДокумент";

        Запрос.УстановитьПараметр("Бронь", Бронь);
        Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

        Если НЕ Запрос.Выполнить().Пустой() Тогда
            Сообщить("Эта бронь уже выкуплена!");
            Отказ = Истина;
            Возврат;
        КонецЕсли;

    КонецЕсли;

    Если УправлениеБилетами.МестоЗанято(
        Сеанс, Место, Ссылка, Бронь) Тогда

        Сообщить("Место уже продано или забронировано!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Движения.Билеты.Очистить();
    Движения.Билеты.Записывать = Истина;

    Движение = Движения.Билеты.Добавить();

    Движение.Сеанс = Сеанс;
    Движение.Место = Место;
    Движение.Статус = "Продано";
    Движение.Цена = Цена;

    // Уникальный идентификатор продажи
    Движение.Операция = Строка(Ссылка.УникальныйИдентификатор());

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

    Если ЗначениеЗаполнено(Сеанс)
        И ЗначениеЗаполнено(Место) Тогда

        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.Билеты");

        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Сеанс", Сеанс);
        Элемент.УстановитьЗначение("Место", Место);

        Блокировка.Заблокировать();

    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Возвраты.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ВозвратБилета КАК Возвраты
    |ГДЕ
    |   Возвраты.Продажа = &Продажа
    |   И Возвраты.Проведен";

    Запрос.УстановитьПараметр("Продажа", Ссылка);

    Если НЕ Запрос.Выполнить().Пустой() Тогда

        Сообщить("Нельзя отменить проведение продажи: по билету уже оформлен возврат!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

КонецПроцедуры