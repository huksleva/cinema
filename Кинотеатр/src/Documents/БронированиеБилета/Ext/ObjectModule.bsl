
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если НЕ ЭтоНовый() Тогда

        СтарыйДокумент = Ссылка.ПолучитьОбъект();

        Если СтарыйДокумент.Проведен Тогда

            Если СтарыйДокумент.Сеанс <> Сеанс
                Или СтарыйДокумент.Место <> Место
                Или СтарыйДокумент.Покупатель <> Покупатель
                Или СтарыйДокумент.ДействуетДо <> ДействуетДо Тогда

                Сообщить("Нельзя изменять проведённую бронь!");
                Отказ = Истина;
                Возврат;

            КонецЕсли;

        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если НЕ ЗначениеЗаполнено(Сеанс)
        Или НЕ ЗначениеЗаполнено(Место)
        Или НЕ ЗначениеЗаполнено(ДействуетДо) Тогда

        Сообщить("Заполни сеанс, место и срок бронирования!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если Место.Зал <> Сеанс.Зал Тогда

        Сообщить("Выбранное место не принадлежит залу сеанса!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если ДействуетДо <= ТекущаяДата() Тогда

        Сообщить("Срок бронирования должен быть в будущем!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если Сеанс.ДатаНачала <= ТекущаяДата() Тогда

        Сообщить("Нельзя забронировать место на начавшийся сеанс!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если ДействуетДо > ТекущаяДата() + 15 * 60 Тогда

        Сообщить("Срок бронирования не может превышать 15 минут!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если ДействуетДо > Сеанс.ДатаНачала Тогда

        Сообщить("Бронь не может действовать дольше начала сеанса!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если УправлениеБилетами.МестоЗанято(
        Сеанс, Место, Ссылка) Тогда

        Сообщить("Место уже продано или забронировано!");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    // Формируем движение бронирования
    Движения.Билеты.Очистить();
    Движения.Билеты.Записывать = Истина;

    Движение = Движения.Билеты.Добавить();

    Движение.Сеанс = Сеанс;
    Движение.Место = Место;
    Движение.Статус = "Забронировано";
    Движение.ДействуетДо = ДействуетДо;

    // Уникальный идентификатор бронирования
    Движение.Операция = Строка(Ссылка.УникальныйИдентификатор());

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

    Если ЗначениеЗаполнено(Сеанс)
        И ЗначениеЗаполнено(Место) Тогда

        Блокировка = Новый БлокировкаДанных;

        Элемент = Блокировка.Добавить(
            "РегистрСведений.Билеты");

        Элемент.Режим =
            РежимБлокировкиДанных.Исключительный;

        Элемент.УстановитьЗначение("Сеанс", Сеанс);
        Элемент.УстановитьЗначение("Место", Место);

        Блокировка.Заблокировать();

    КонецЕсли;

    // Проверяем, выкуплена ли бронь
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Продажи.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ПродажаБилета КАК Продажи
    |ГДЕ
    |   Продажи.Бронь = &Бронь
    |   И Продажи.Проведен";

    Запрос.УстановитьПараметр("Бронь", Ссылка);

    Если НЕ Запрос.Выполнить().Пустой() Тогда

        Сообщить(
            "Нельзя отменить проведение брони: " +
            "по ней уже продан билет!");

        Отказ = Истина;
        Возврат;

    КонецЕсли;

КонецПроцедуры


