&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма, "ПОКУПКА / ПРИХОД");
    Реквизиты = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "РеквизитыДокумента", "", Неопределено, Истина);
    ДанныеДокумента = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "ДанныеДокумента", "Документ", Реквизиты);
    КинотеатрСервер.ДобавитьПоле(ЭтаФорма, "Номер", "Объект.Номер", ДанныеДокумента);
    КинотеатрСервер.ДобавитьПоле(ЭтаФорма, "Дата", "Объект.Дата", ДанныеДокумента);
    Участники = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "Участники", "Участники операции", Реквизиты);
    КинотеатрСервер.ДобавитьПоле(ЭтаФорма, "Организация", "Объект.Организация", Участники);
    
    ТоварыГруппа = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "ТоварыГруппа", "Товары кинобара");
    Таблица = Элементы.Добавить("Товары", Тип("ТаблицаФормы"), ТоварыГруппа);
    Таблица.ПутьКДанным = "Объект.Товары";
    КинотеатрСервер.ОформитьТаблицу(Таблица);
    Таблица.УстановитьДействие("ПослеУдаления", "ТоварыПослеУдаления");
    Для Каждого Имя Из СтрРазделить("Номенклатура,Количество,Цена,Сумма", ",") Цикл
        Поле = КинотеатрСервер.ДобавитьПоле(ЭтаФорма, "Товары" + Имя, "Объект.Товары." + Имя, Таблица);
        Если Имя = "Номенклатура" Тогда Поле.Ширина = 36; Поле.Заголовок = "Товар"; КонецЕсли;
        Если Имя = "Сумма" Тогда
            Поле.ТолькоПросмотр = Истина;
        Иначе
            Поле.УстановитьДействие("ПриИзменении", "ТоварыПриИзменении");
        КонецЕсли;
    КонецЦикла;
    ИтогГруппа = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "ИтогГруппа", "");
    ИтогГруппа.ЦветФона = Новый Цвет(253, 242, 217);
    КинотеатрСервер.ДобавитьНадпись(ЭтаФорма, "ИтогДокумента", "ИТОГО: " + Формат(Объект.Товары.Итог("Сумма"), "ЧДЦ=2") + " ₽", ИтогГруппа, 18);
    КомментарийГруппа = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "КомментарийГруппа", "Примечание");
    КинотеатрСервер.ДобавитьПоле(ЭтаФорма, "Комментарий", "Объект.Комментарий", КомментарийГруппа);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        
        СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
    КонецЕсли;
    ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
    ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтог()
    Элементы.ИтогДокумента.Заголовок = "ИТОГО: " + Формат(Объект.Товары.Итог("Сумма"), "ЧДЦ=2") + " ₽";
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦену(Товар, ДатаДокумента)
    Возврат КинотеатрСервер.ЦенаНаДату(Товар, ДатаДокумента);
КонецФункции
