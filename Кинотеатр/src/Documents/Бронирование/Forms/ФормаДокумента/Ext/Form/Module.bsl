// ==================== СОБЫТИЯ ТАБЛИЦЫ ТОВАРОВ ====================

// 1. При выборе товара — автоматически подтягиваем цену и считаем сумму
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
    
    ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
    
    // Получаем цену товара из базы
    ТекущаяСтрока.Цена = ПолучитьЦенуНоменклатурыНаСервере(ТекущаяСтрока.Номенклатура);
    
    // Если количество не заполнено — ставим 1 шт
    Если ТекущаяСтрока.Количество = 0 Тогда
        ТекущаяСтрока.Количество = 1;
    КонецЕсли;
    
    // Автоматический расчет суммы строки и суммы всего документа
    ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
    Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
    
КонецПроцедуры

// 2. При изменении количества — пересчитываем сумму
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
    
    ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
    
    ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
    Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
    
КонецПроцедуры

// 3. При ручном изменении цены — пересчитываем сумму
&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
    
    ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
    
    ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
    Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
    
КонецПроцедуры

// Цена продажи всегда читается из единого регистра сведений "Цены".
&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатурыНаСервере(Номенклатура)
    Если Не ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат 0;
    КонецЕсли;
    Возврат КинотеатрСервер.ЦенаНаДату(Номенклатура, ТекущаяДата());
КонецФункции


// ==================== КНОПКИ ВЫКУПА И ОТМЕНЫ БРОНИ ====================

&НаКлиенте
Процедура ВыкупитьБронь(Команда)
    
    Если Не Объект.Проведен Тогда
        Предупреждение("Выкупить можно только проведенную (активную) бронь!");
        Возврат;
    КонецЕсли;
    
    РезультатВыкупа = ВыкупитьБроньНаСервере();
    
    Если РезультатВыкупа <> Неопределено И ЗначениеЗаполнено(РезультатВыкупа.Ссылка) Тогда
        ПоказатьОповещениеПользователя("Успешная продажа", , "Создан и проведен чек расхода № " + РезультатВыкупа.Номер);
        // Открываем созданный чек продажи
        ПараметрыОткрытия = Новый Структура("Ключ", РезультатВыкупа.Ссылка);
        ОткрытьФорму("Документ.Расход.ФормаОбъекта", ПараметрыОткрытия);
        ЭтаФорма.Закрыть();
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ВыкупитьБроньНаСервере()
    
    ДокБронь = РеквизитФормыВЗначение("Объект");
    
    // 1. Создаем реальный документ продажи (Расход)
    НовыйЧек = Документы.Расход.СоздатьДокумент();
    НовыйЧек.Дата = ТекущаяДата();
    НовыйЧек.Организация = ДокБронь.Организация;
    НовыйЧек.Покупатель = ДокБронь.Покупатель;
    НовыйЧек.ДокументОснование = ДокБронь.Ссылка; // Связываем с бронью!
    
    Для Каждого Стр Из ДокБронь.Товары Цикл
        Нов = НовыйЧек.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Нов, Стр);
    КонецЦикла;
    
    // Проводим продажу (списывает склад и закрывает резерв)
    НовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
    
    // 2. Меняем статус у брони
    ДокБронь.Статус = "Выкуплено";
    ДокБронь.Записать(РежимЗаписиДокумента.Запись);
    ЗначениеВРеквизитФормы(ДокБронь, "Объект");
    
    // Возвращаем структуру со ссылкой и номером строкой (без ошибки на клиенте)
    Результат = Новый Структура;
    Результат.Вставить("Ссылка", НовыйЧек.Ссылка);
    Результат.Вставить("Номер", НовыйЧек.Номер);
    Возврат Результат;
    
КонецФункции

&НаКлиенте
Процедура ОтменитьБронь(Команда)
    
    Если Объект.Ссылка.Пустая() Тогда
        Предупреждение("Сначала запишите документ!");
        Возврат;
    КонецЕсли;
    
    ОтменитьБроньНаСервере();
    ПоказатьОповещениеПользователя("Бронь отменена", , "Товары возвращены в свободные остатки!");
    ЭтаФорма.Закрыть();
    
КонецПроцедуры

&НаСервере
Процедура ОтменитьБроньНаСервере()
    
    ДокОбъект = РеквизитФормыВЗначение("Объект");
    // Отмена проведения удаляет запись из РезервыТоваров -> свободный остаток восстанавливается
    ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ДокОбъект.Статус = "Отменено";
    ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
    ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
    
КонецПроцедуры
