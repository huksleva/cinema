Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
    // При создании нового документа статус автоматически ставится "Забронировано"
    Статус = "Забронировано";
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        ЗапросПродаж = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Расход ГДЕ Проведен И ДокументОснование = &Бронь");
        ЗапросПродаж.УстановитьПараметр("Бронь", Ссылка);
        Если Не ЗапросПродаж.Выполнить().Пустой() Тогда
            Сообщить("Проданную бронь нельзя отменить. Сначала отмените продажу");
            Отказ = Истина; Возврат;
        КонецЕсли;
    КонецЕсли;
	// Не записываем бронь с невыбранной ценой и всегда пересчитываем суммы на сервере.
	Для Каждого СтрокаТовара Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			Или СтрокаТовара.Количество <= 0
			Или СтрокаТовара.Цена <= 0 Тогда
			Сообщить("В каждой строке брони укажите товар, положительное количество и цену из регистра «Цены».");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
	КонецЦикла;
	// Автоматический расчет общей суммы документа по всем строкам таблицы
    СуммаДокумента = Товары.Итог("Сумма");
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	
	Если Не ЗначениеЗаполнено(Организация) Или Товары.Количество() = 0 Тогда
    Сообщить("Укажите организацию и товары"); Отказ = Истина; Возврат;
КонецЕсли;

Если Не ЗначениеЗаполнено(СрокБрони) Тогда
    Сообщить("Заполните срок брони");
    Отказ = Истина;
    Возврат;
КонецЕсли;

Если СрокБрони <= Дата Тогда
    Сообщить("Срок брони должен быть позже даты документа");
    Отказ = Истина;
    Возврат;
КонецЕсли;
    
    // Штатная блокировка вашей конфигурации
    КинотеатрСервер.ЗаблокироватьОстатки(Организация);
    
    // Включаем запись движений по регистру резервов
    Движения.РезервыТоваров.Записывать = Истина;
    Движения.РезервыТоваров.Очистить();
    
    // Сворачиваем одинаковые строки перед отправкой в запрос
    Для Каждого СтрокаТовара Из Товары Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или СтрокаТовара.Количество <= 0 Тогда
            Сообщить("Укажите товар и положительное количество"); Отказ = Истина; Возврат;
        КонецЕсли;
    КонецЦикла;
    ТаблицаТоваров = Товары.Выгрузить();
    ТаблицаТоваров.Свернуть("Номенклатура", "Количество");
    
    // ЗАПРОС: рассчитывает свободный остаток (Склад МИНУС Резервы)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   ДокТовары.Номенклатура КАК Номенклатура,
    |   ДокТовары.Количество КАК ТребуетсяЗабронировать
    |ПОМЕСТИТЬ ВТ_ТоварыДокумента
    |ИЗ
    |   &ТаблицаТоваров КАК ДокТовары
    |;
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ.Номенклатура КАК Номенклатура,
    |   ВТ.Номенклатура.Наименование КАК НоменклатураНаименование,
    |   ВТ.ТребуетсяЗабронировать КАК Требуется,
    |   ЕСТЬNULL(Склад.КоличествоОстаток, 0) - ЕСТЬNULL(Резервы.КоличествоОстаток, 0) КАК СвободныйОстаток
    |ИЗ
    |   ВТ_ТоварыДокумента КАК ВТ
    |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Организация = &Организация) КАК Склад
    |       ПО ВТ.Номенклатура = Склад.Номенклатура
    |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыТоваров.Остатки(&Момент, Организация = &Организация) КАК Резервы
    |       ПО ВТ.Номенклатура = Резервы.Номенклатура";
    
    Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
    Запрос.УстановитьПараметр("Момент", МоментВремени());
    Запрос.УстановитьПараметр("Организация", Организация);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        
        // ПРОВЕРКА: есть ли столько свободного товара?
        Если Выборка.СвободныйОстаток < Выборка.Требуется Тогда
            
            Нехватка = Выборка.Требуется - Выборка.СвободныйОстаток;
            
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = СтрШаблон(
                "Отказ бронирования! По позиции «%1» доступно свободно: %2 шт., запрошено: %3 шт. (Дефицит: %4 шт.)",
                Выборка.НоменклатураНаименование, 
                Выборка.СвободныйОстаток, 
                Выборка.Требуется, 
                Нехватка);
            Сообщение.Поле = "Товары";
            Сообщение.Сообщить();
            
            Отказ = Истина;
            
        Иначе
            
            // Товар есть -> Ставим в резерв (ушло из свободных остатков!)
            Движение = Движения.РезервыТоваров.ДобавитьПриход();
            Движение.Период = Дата;
            Движение.Организация = Организация;
            Движение.Номенклатура = Выборка.Номенклатура;
            Движение.Количество = Выборка.Требуется;
            
        КонецЕсли;
        
    КонецЦикла;
    
    Если Не Отказ Тогда
        Движения.РезервыТоваров.Записать();
        КинотеатрСервер.ПроверитьДоступность(Организация, Отказ);
    КонецЕсли;
    Если Не Отказ Тогда
        Статус = "Забронировано";
    КонецЕсли;

КонецПроцедуры
