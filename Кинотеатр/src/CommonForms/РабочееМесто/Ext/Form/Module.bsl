&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма, "РАБОЧЕЕ МЕСТО / КИНОБАР");
    РабочаяОбласть = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "РабочаяОбласть", "", Неопределено, Истина);
    Действия = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "Действия", "Быстрые действия", РабочаяОбласть);
    Действия.Ширина = 30;
    Действия.РастягиватьПоГоризонтали = Ложь;
    Названия = Новый Структура("НоваяПродажа,НовыйПриход,Товары,Покупатели,Организации,Цены,ОтчетПродажи,ОбновитьОстатки", "Новая продажа", "Новый приход", "Номенклатура", "Покупатели", "Организации", "Цены", "Отчет по продажам", "Обновить остатки");
    Для Каждого Имя Из СтрРазделить("НоваяПродажа,НовыйПриход,Товары,Покупатели,Организации,Цены,ОтчетПродажи,ОбновитьОстатки", ",") Цикл
        Название = Названия[Имя];
        Команда = Команды.Добавить(Имя);
        Команда.Заголовок = Название;
        Команда.Действие = Имя;
        Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Действия);
        Кнопка.ИмяКоманды = Имя;
        Кнопка.Ширина = 26;
        Кнопка.Высота = 2;
        КинотеатрСервер.ОформитьКнопку(Кнопка, Имя = "НоваяПродажа");
        Если Имя = "НоваяПродажа" Тогда Кнопка.Доступность = ПравоДоступа("Добавление", Метаданные.Документы.Расход); КонецЕсли;
        Если Имя = "НовыйПриход" Тогда Кнопка.Доступность = ПравоДоступа("Добавление", Метаданные.Документы.Приход); КонецЕсли;
    КонецЦикла;
    Сводка = КинотеатрСервер.ДобавитьГруппу(ЭтаФорма, "Сводка", "Остатки товаров кинобара", РабочаяОбласть);
    Поле = Элементы.Добавить("ТаблицаОстатков", Тип("ПолеФормы"), Сводка);
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "Остатки";
    Поле.Высота = 19;
    Поле.РастягиватьПоГоризонтали = Истина;
    КинотеатрСервер.ДобавитьНадпись(ЭтаФорма, "Подсказка", "Продажа списывает остатки. Приход пополняет склад. Фотографии доступны в карточках номенклатуры.", Сводка);
    ОбновитьОстаткиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстатки(Команда)
    ОбновитьОстаткиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиНаСервере()
    Остатки = КинотеатрСервер.Отчет("Остатки");
КонецПроцедуры

