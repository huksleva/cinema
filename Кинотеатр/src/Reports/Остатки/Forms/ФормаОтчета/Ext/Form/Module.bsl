&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма, "ОТЧЕТЫ / ОСТАТКИ ТОВАРОВ");
    Поле = Элементы.Добавить("ТаблицаОтчета", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "Результат";
    Команда = Команды.Добавить("Обновить");
    Команда.Действие = "Обновить";
    Команда.Заголовок = "Обновить отчет";
    Кнопка = Элементы.Добавить("ОбновитьОтчет", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
    Кнопка.ИмяКоманды = "Обновить";
    КинотеатрСервер.ОформитьКнопку(Кнопка, Истина);
    Сформировать();
КонецПроцедуры
&НаКлиенте
Процедура Обновить(Команда)
    Сформировать();
КонецПроцедуры
&НаСервере
Процедура Сформировать()
    ЭтаФорма.Результат = КинотеатрСервер.Отчет("Остатки");
КонецПроцедуры
