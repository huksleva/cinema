&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма);
    Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда НачалоПериода = НачалоДня(ТекущаяДата()) - 30 * 86400; КонецЕсли;
    Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда КонецПериода = КонецДня(ТекущаяДата()); КонецЕсли;
    Для Каждого Имя Из СтрРазделить("НачалоПериода,КонецПериода", ",") Цикл
        ПолеПериода = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        ПолеПериода.Вид = ВидПоляФормы.ПолеВвода;
        ПолеПериода.ПутьКДанным = Имя;
    КонецЦикла;
    Элементы.НачалоПериода.Заголовок = "Начало периода";
    Элементы.КонецПериода.Заголовок = "Окончание периода";
    Поле = Элементы.Добавить("ТаблицаОтчета", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "Результат";
    Команда = Команды.Добавить("Обновить");
    Команда.Действие = "Обновить";
    Команда.Заголовок = "Обновить отчет";
    Кнопка = Элементы.Добавить("ОбновитьОтчет", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
    Кнопка.ИмяКоманды = "Обновить";
    Сформировать();
КонецПроцедуры
&НаКлиенте
Процедура Обновить(Команда)
    Сформировать();
КонецПроцедуры
&НаСервере
Процедура Сформировать()
    Если НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода не может быть позже окончания.");
        Возврат;
    КонецЕсли;
    ЭтаФорма.Результат = КинотеатрСервер.ОтчетПродажЗаПериод(НачалоПериода, КонецПериода);
КонецПроцедуры
