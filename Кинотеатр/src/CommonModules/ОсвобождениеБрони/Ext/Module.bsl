
Процедура ОсвободитьМеста() Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Билеты.Регистратор КАК Регистратор
    |ИЗ
    |   РегистрСведений.Билеты КАК Билеты
    |ГДЕ
    |   Билеты.Статус = &Статус
    |   И Билеты.ДействуетДо <= &Сейчас";

    Запрос.УстановитьПараметр("Статус", "Забронировано");
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        ДокументБрони = Выборка.Регистратор.ПолучитьОбъект();

        Если ДокументБрони.Проведен Тогда
            ДокументБрони.Записать(
                РежимЗаписиДокумента.ОтменаПроведения);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
