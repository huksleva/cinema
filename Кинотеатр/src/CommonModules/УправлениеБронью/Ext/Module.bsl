Процедура СнятьПросроченныеБрони() Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Бронь.Ссылка КАК Ссылка
        |ИЗ
        |    Документ.Бронирование КАК Бронь
        |ГДЕ
        |    Бронь.Проведен
        |    И Бронь.Статус = &Статус
        |    И Бронь.СрокБрони > &ПустаяДата
        |    И Бронь.СрокБрони <= &Сейчас
        |    И Бронь.Ссылка НЕ В (ВЫБРАТЬ Продажа.ДокументОснование ИЗ Документ.Расход КАК Продажа
        |        ГДЕ Продажа.Проведен)";

    Запрос.УстановитьПараметр("Статус", "Забронировано");
    Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        ОбъектБрони = Выборка.Ссылка.ПолучитьОбъект();

        // Так же, как существующая кнопка отмены:
        // отмена проведения убирает движения из РезервыТоваров.
        Попытка
            ОбъектБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
            ОбъектБрони.Статус = "Истекло";
            ОбъектБрони.Записать(РежимЗаписиДокумента.Запись);
        Исключение
            ЗаписьЖурналаРегистрации("Бронирование.СнятиеПросроченных", УровеньЖурналаРегистрации.Ошибка,
                , Выборка.Ссылка, ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

КонецПроцедуры
