Функция МестоЗанято(Сеанс, Место, ТекущийДокумент,
    ВыкупаемаяБронь = Неопределено) Экспорт

    // Блокируем записи выбранного сеанса и места
    Блокировка = Новый БлокировкаДанных;

    Элемент = Блокировка.Добавить(
        "РегистрСведений.Билеты");

    Элемент.Режим = РежимБлокировкиДанных.Исключительный;

    Элемент.УстановитьЗначение("Сеанс", Сеанс);
    Элемент.УстановитьЗначение("Место", Место);

    Блокировка.Заблокировать();

    // Получаем записи по месту
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Билеты.Регистратор КАК Регистратор,
    |   Билеты.Статус КАК Статус,
    |   Билеты.ДействуетДо КАК ДействуетДо
    |ИЗ
    |   РегистрСведений.Билеты КАК Билеты
    |ГДЕ
    |   Билеты.Сеанс = &Сеанс
    |   И Билеты.Место = &Место
    |   И Билеты.Регистратор <> &ТекущийДокумент";

    Запрос.УстановитьПараметр("Сеанс", Сеанс);
    Запрос.УстановитьПараметр("Место", Место);
    Запрос.УстановитьПараметр(
        "ТекущийДокумент", ТекущийДокумент);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        Если Выборка.Статус = "Продано" Тогда

            // Проверяем возврат продажи
            ЗапросВозврата = Новый Запрос;

            ЗапросВозврата.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Возвраты.Ссылка КАК Ссылка
            |ИЗ
            |   Документ.ВозвратБилета КАК Возвраты
            |ГДЕ
            |   Возвраты.Продажа = &Продажа
            |   И Возвраты.Проведен";

            ЗапросВозврата.УстановитьПараметр(
                "Продажа", Выборка.Регистратор);

            Если ЗапросВозврата.Выполнить().Пустой() Тогда
                Возврат Истина;
            КонецЕсли;

        ИначеЕсли Выборка.Статус = "Забронировано" Тогда

            // Просроченная бронь не занимает место
            Если Выборка.ДействуетДо <= ТекущаяДата() Тогда
                Продолжить;
            КонецЕсли;

            // Проверяем, выкуплена ли бронь
            ЗапросВыкупа = Новый Запрос;

            ЗапросВыкупа.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Продажи.Ссылка КАК Ссылка
            |ИЗ
            |   Документ.ПродажаБилета КАК Продажи
            |ГДЕ
            |   Продажи.Бронь = &Бронь
            |   И Продажи.Проведен";

            ЗапросВыкупа.УстановитьПараметр(
                "Бронь", Выборка.Регистратор);

            Если НЕ ЗапросВыкупа.Выполнить().Пустой() Тогда
                Продолжить;
            КонецЕсли;

            // Разрешаем выкуп собственной брони
            Если ЗначениеЗаполнено(ВыкупаемаяБронь) Тогда

                Если Выборка.Регистратор = ВыкупаемаяБронь Тогда
                    Продолжить;
                КонецЕсли;

            КонецЕсли;

            Возврат Истина;

        КонецЕсли;

    КонецЦикла;

    Возврат Ложь;

КонецФункции