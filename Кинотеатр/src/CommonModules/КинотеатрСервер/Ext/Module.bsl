Процедура ОформитьФорму(Форма, Раздел = "КИНОБАР / УЧЕТ ТОВАРОВ") Экспорт
    Шапка = ДобавитьГруппу(Форма, "КинотеатрШапка", "", Неопределено);
    Шапка.ЦветФона = Новый Цвет(32, 36, 43);
    Заголовок = ДобавитьНадпись(Форма, "КинотеатрЗаголовок", "КИНОТЕАТР  /  ПРЕМЬЕРА", Шапка, 20);
    Заголовок.ЦветТекста = Новый Цвет(255, 255, 255);
    Подзаголовок = ДобавитьНадпись(Форма, "КинотеатрРаздел", Раздел, Шапка, 10);
    Подзаголовок.ЦветТекста = Новый Цвет(246, 186, 67);
КонецПроцедуры

Функция ДобавитьГруппу(Форма, Имя, Заголовок, Родитель = Неопределено, Горизонтально = Ложь) Экспорт
    Группа = Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Группировка = ?(Горизонтально, ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
    Группа.ОтображатьЗаголовок = Не ПустаяСтрока(Заголовок);
    Группа.Заголовок = Заголовок;
    Группа.ЦветТекстаЗаголовка = Новый Цвет(37, 42, 49);
    Группа.ШрифтЗаголовка = Новый Шрифт(, 12, Истина);
    Группа.РастягиватьПоГоризонтали = Истина;
    Возврат Группа;
КонецФункции

Функция ДобавитьНадпись(Форма, Имя, Текст, Родитель = Неопределено, Размер = 10) Экспорт
    Надпись = Форма.Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
    Надпись.Вид = ВидДекорацииФормы.Надпись;
    Надпись.Заголовок = Текст;
    Надпись.Шрифт = Новый Шрифт(, Размер, Размер >= 12);
    Надпись.ЦветТекста = Новый Цвет(37, 42, 49);
    Надпись.РастягиватьПоГоризонтали = Истина;
    Возврат Надпись;
КонецФункции

Функция ДобавитьПоле(Форма, Имя, ПутьКДанным, Родитель, Заголовок = "") Экспорт
    Поле = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = ПутьКДанным;
    Если Не ПустаяСтрока(Заголовок) Тогда Поле.Заголовок = Заголовок; КонецЕсли;
    Поле.ЦветФона = Новый Цвет(255, 255, 255);
    Возврат Поле;
КонецФункции

Процедура ОформитьТаблицу(Таблица) Экспорт
    Таблица.ЦветФона = Новый Цвет(255, 255, 255);
    Таблица.ЦветТекста = Новый Цвет(37, 42, 49);
    Таблица.ЧередованиеЦветовСтрок = Истина;
    Таблица.Высота = 12;
    Таблица.РастягиватьПоГоризонтали = Истина;
КонецПроцедуры

Процедура ОформитьКнопку(Кнопка, Основная = Ложь) Экспорт
    Кнопка.ЦветФона = ?(Основная, Новый Цвет(246, 186, 67), Новый Цвет(255, 255, 255));
    Кнопка.ЦветТекста = Новый Цвет(37, 42, 49);
    Кнопка.Шрифт = Новый Шрифт(, 10, Основная);
КонецПроцедуры


Функция ЦенаНаДату(Номенклатура, ДатаЦены) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.Цены.СрезПоследних(&ДатаЦены, Номенклатура = &Номенклатура)";
    Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Возврат Выборка.Цена; КонецЕсли;
    Возврат 0;
КонецФункции

Процедура ПроверитьДокумент(Документ, Отказ) Экспорт
    Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
        Сообщить("Укажите организацию"); Отказ = Истина;
    КонецЕсли;
    Если Документ.Товары.Количество() = 0 Тогда
        Сообщить("Добавьте хотя бы один товар"); Отказ = Истина;
    КонецЕсли;
    Для Каждого СтрокаТовара Из Документ.Товары Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или СтрокаТовара.Количество <= 0 Тогда
            Сообщить("В каждой строке укажите товар и положительное количество"); Отказ = Истина;
        КонецЕсли;
        Если Документ.Метаданные().Имя = "Расход" И СтрокаТовара.Цена = 0 Тогда
            СтрокаТовара.Цена = ЦенаНаДату(СтрокаТовара.Номенклатура, Документ.Дата);
        КонецЕсли;
        Если СтрокаТовара.Цена <= 0 Тогда
            Сообщить("Цена должна быть больше нуля. Для продажи сначала установите цену в регистре Цены"); Отказ = Истина;
        КонецЕсли;
        СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьОстатки(Организация) Экспорт
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьОстатки(Организация, Отказ) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, КоличествоОстаток ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Организация = &Организация) ГДЕ КоличествоОстаток < 0");
    Запрос.УстановитьПараметр("Организация", Организация);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("Недостаточно товара: " + Строка(Выборка.Номенклатура)); Отказ = Истина;
    КонецЦикла;
КонецПроцедуры

Функция Отчет(ВидОтчета) Экспорт
    Если ВидОтчета = "Остатки" Тогда
        ТекстЗапроса = "ВЫБРАТЬ Организация.Наименование КАК Организация, Номенклатура.Наименование КАК Товар, КоличествоОстаток КАК Количество ИЗ РегистрНакопления.ОстаткиТоваров.Остатки УПОРЯДОЧИТЬ ПО Организация, Товар";
    Иначе
        ТекстЗапроса = "ВЫБРАТЬ Организация.Наименование КАК Организация, Номенклатура.Наименование КАК Товар, СУММА(Количество) КАК Количество, СУММА(Сумма) КАК Выручка ИЗ РегистрНакопления.Продажи ГДЕ Активность СГРУППИРОВАТЬ ПО Организация.Наименование, Номенклатура.Наименование УПОРЯДОЧИТЬ ПО Организация, Товар";
    КонецЕсли;
    ЗапросОтчета = Новый Запрос(ТекстЗапроса);
    Таблица = ЗапросОтчета.Выполнить().Выгрузить();
    Документ = Новый ТабличныйДокумент;
    Документ.Область(1, 1).Текст = "КИНОТЕАТР / " + ВидОтчета;
    Документ.Область(1, 1).ЦветТекста = Новый Цвет(32, 36, 43);
    КолонкаНомер = 0;
    Для Каждого Колонка Из Таблица.Колонки Цикл
        КолонкаНомер = КолонкаНомер + 1;
        Область = Документ.Область(3, КолонкаНомер);
        Область.Текст = Колонка.Имя;
        Область.ЦветФона = Новый Цвет(32, 36, 43);
        Область.ЦветТекста = Новый Цвет(255, 255, 255);
        Область.ШиринаКолонки = 28;
        Область.Шрифт = Новый Шрифт(, 11, Истина);
    КонецЦикла;
    НомерСтроки = 4;
    Для Каждого СтрокаДанных Из Таблица Цикл
        Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
            Область = Документ.Область(НомерСтроки, Индекс + 1);
            Область.Текст = Строка(СтрокаДанных[Индекс]);
            Если НомерСтроки % 2 = 0 Тогда Область.ЦветФона = Новый Цвет(250, 247, 239); КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    Возврат Документ;
КонецФункции

Функция НайтиИлиСоздать(ИмяСправочника, Наименование) Экспорт
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Наименование;
    Если ИмяСправочника = "Номенклатура" Тогда Объект.ЕдиницаИзмерения = "шт"; КонецЕсли;
    Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Процедура ЗаписатьЦену(Товар, Цена, Период)
    Запись = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
    Запись.Период = Период; Запись.Номенклатура = Товар; Запись.Цена = Цена; Запись.Записать();
КонецПроцедуры

Процедура ЗаполнитьДемо() Экспорт
    Организация = НайтиИлиСоздать("Организации", "Кинотеатр Премьера");
    Покупатель = НайтиИлиСоздать("Покупатели", "Розничный покупатель");
    Попкорн = НайтиИлиСоздать("Номенклатура", "Попкорн соленый большой");
    Напиток = НайтиИлиСоздать("Номенклатура", "Напиток 0,5 л");
    Начало = Дата(2026, 10, 20, 9, 0, 0);
    ЗаписатьЦену(Попкорн, 250, Начало); ЗаписатьЦену(Напиток, 150, Начало);
    Выборка = Документы.Приход.Выбрать();
    Если Выборка.Следующий() Тогда
        ОбновитьДемоРасчеты(Организация);
        Возврат;
    КонецЕсли;
    Приход = Документы.Приход.СоздатьДокумент(); Приход.Дата = Начало + 60; Приход.Организация = Организация;
    СтрокаДок = Приход.Товары.Добавить(); СтрокаДок.Номенклатура = Попкорн; СтрокаДок.Количество = 100; СтрокаДок.Цена = 80;
    СтрокаДок = Приход.Товары.Добавить(); СтрокаДок.Номенклатура = Напиток; СтрокаДок.Количество = 50; СтрокаДок.Цена = 45;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Расход = Документы.Расход.СоздатьДокумент(); Расход.Дата = Начало + 120; Расход.Организация = Организация; Расход.Покупатель = Покупатель;
    СтрокаДок = Расход.Товары.Добавить(); СтрокаДок.Номенклатура = Попкорн; СтрокаДок.Количество = 3;
    СтрокаДок = Расход.Товары.Добавить(); СтрокаДок.Номенклатура = Напиток; СтрокаДок.Количество = 2;
    Расход.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ОбновитьДемоРасчеты(Организация)
    Для Каждого ИмяДокумента Из СтрРазделить("Приход,Расход", ",") Цикл
        ВыборкаДемо = Документы[ИмяДокумента].Выбрать(Дата(2026, 10, 20, 9, 0, 0), Дата(2026, 10, 20, 9, 3, 0));
        Пока ВыборкаДемо.Следующий() Цикл
            Если ВыборкаДемо.Организация = Организация И ВыборкаДемо.Проведен Тогда
                ДокументДемо = ВыборкаДемо.ПолучитьОбъект();
                ДокументДемо.Записать(РежимЗаписиДокумента.Проведение);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьДемоФото(Каталог) Экспорт
    Товар = Справочники.Номенклатура.НайтиПоНаименованию("Попкорн соленый большой", Истина).ПолучитьОбъект();
    Товар.Фото = Новый ХранилищеЗначения(Новый ДвоичныеДанные(Каталог + "\popcorn.jpg"));
    Товар.Записать();
КонецПроцедуры

Функция ОстатокТовара(Организация, Товар)
    Запрос = Новый Запрос("ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Организация = &Организация И Номенклатура = &Товар)");
    Запрос.УстановитьПараметр("Организация", Организация); Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать(); Если Выборка.Следующий() Тогда Возврат Выборка.КоличествоОстаток; КонецЕсли; Возврат 0;
КонецФункции

Процедура Проверка(Условие, ИмяТеста, Лог)
    Если Не Условие Тогда ВызватьИсключение "FAIL " + ИмяТеста; КонецЕсли;
    Лог.Добавить("PASS " + ИмяТеста);
КонецПроцедуры

Функция Самопроверка() Экспорт
    Лог = Новый Массив;
    НачатьТранзакцию();
    Попытка
        Организация = НайтиИлиСоздать("Организации", "Тестовая организация");
        ДругаяОрганизация = НайтиИлиСоздать("Организации", "Другая организация");
        Товар = НайтиИлиСоздать("Номенклатура", "Тестовый товар");
        ДатаТеста = Дата(2026, 10, 20, 12, 0, 0);
        ЗаписатьЦену(Товар, 200, ДатаТеста); ЗаписатьЦену(Товар, 250, ДатаТеста + 600);
        Проверка(ЦенаНаДату(Товар, ДатаТеста + 300) = 200, "01 Цена на дату", Лог);
        Проверка(ЦенаНаДату(Товар, ДатаТеста + 900) = 250, "02 Новая цена", Лог);
        Приход = Документы.Приход.СоздатьДокумент(); Приход.Дата = ДатаТеста + 1; Приход.Организация = Организация;
        СтрДок = Приход.Товары.Добавить(); СтрДок.Номенклатура = Товар; СтрДок.Количество = 10; СтрДок.Цена = 100;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Проверка(ОстатокТовара(Организация, Товар) = 10, "03 Приход увеличивает остаток", Лог);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Проверка(ОстатокТовара(Организация, Товар) = 10, "04 Перепроведение не удваивает движения", Лог);
        Расход = Документы.Расход.СоздатьДокумент(); Расход.Дата = ДатаТеста + 2; Расход.Организация = Организация;
        Для Индекс = 1 По 2 Цикл
            СтрДок = Расход.Товары.Добавить(); СтрДок.Номенклатура = Товар; СтрДок.Количество = 2;
        КонецЦикла;
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        Проверка(ОстатокТовара(Организация, Товар) = 6, "05 Расход и повторяющиеся товары", Лог);
        СохраненныйРасход = Расход.Ссылка.ПолучитьОбъект();
        Проверка(СохраненныйРасход.Товары[0].Цена = 200 И СохраненныйРасход.Товары[0].Сумма = 400, "06 Автоцена и сумма", Лог);
        Проверка(ОстатокТовара(ДругаяОрганизация, Товар) = 0, "07 Разделение по организациям", Лог);
        Расход.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Проверка(ОстатокТовара(Организация, Товар) = 10, "08 Отмена продажи возвращает остаток", Лог);
        Проверка(Отчет("Остатки").ВысотаТаблицы >= 4, "09 Отчет остатков", Лог);
        Проверка(Отчет("Продажи").ВысотаТаблицы >= 3, "10 Отчет продаж", Лог);
        ОтменитьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); Лог.Добавить("FAIL " + ОписаниеОшибки());
    КонецПопытки;
    Попытка
        Организация = Справочники.Организации.НайтиПоНаименованию("Кинотеатр Премьера", Истина);
        Товар = Справочники.Номенклатура.НайтиПоНаименованию("Попкорн соленый большой", Истина);
        Было = ОстатокТовара(Организация, Товар);
        Расход = Документы.Расход.СоздатьДокумент(); Расход.Дата = Дата(2026, 10, 20, 14, 0, 0); Расход.Организация = Организация;
        СтрДок = Расход.Товары.Добавить(); СтрДок.Номенклатура = Товар; СтрДок.Количество = Было + 1000; СтрДок.Цена = 250;
        ОтказПолучен = Ложь;
        Попытка Расход.Записать(РежимЗаписиДокумента.Проведение); Исключение ОтказПолучен = Истина; КонецПопытки;
        Проверка(ОтказПолучен И ОстатокТовара(Организация, Товар) = Было, "11 Нехватка товара отклонена без изменения остатков", Лог);
        ПриходВыборка = Документы.Приход.Выбрать(); ПриходВыборка.Следующий(); ПриходДемо = ПриходВыборка.ПолучитьОбъект();
        ОтказПолучен = Ложь;
        Попытка ПриходДемо.Записать(РежимЗаписиДокумента.ОтменаПроведения); Исключение ОтказПолучен = Истина; КонецПопытки;
