Процедура ПередЗаписью(Отказ)
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат;
	КонецЕсли;

	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Сообщить("ИНН должен содержать 10 или 12 цифр.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(ИНН) Цикл
		Если СтрНайти("0123456789", Сред(ИНН, Индекс, 1)) = 0 Тогда
			Сообщить("ИНН может содержать только цифры.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
