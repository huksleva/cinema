&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Для Каждого Имя Из СтрРазделить("Наименование,Зал,Ряд,НомерМеста,Категория", ",") Цикл
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект." + Имя;
    КонецЦикла;
    Элементы.Категория.РежимВыбораИзСписка = Истина;
    Для Каждого Значение Из СтрРазделить("Стандарт,Комфорт,Премиум,VIP,Диван", ",") Цикл Элементы.Категория.СписокВыбора.Добавить(Значение); КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если ТекущийОбъект.Ряд < 1 Или ТекущийОбъект.Ряд > 999 Или ТекущийОбъект.НомерМеста < 1 Или ТекущийОбъект.НомерМеста > 999 Тогда
        Отказ = Истина;
        Сообщить("Ряд и номер места должны быть от 1 до 999.");
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Зал) Тогда
        Отказ = Истина;
        Сообщить("Выберите зал для места.");
        Возврат;
    КонецЕсли;
    Если ТекущийОбъект.Ряд > ТекущийОбъект.Зал.Вместимость Или ТекущийОбъект.НомерМеста > ТекущийОбъект.Зал.Вместимость Тогда
        Отказ = Истина;
        Сообщить("Ряд и номер места не могут превышать вместимость выбранного зала.");
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1 Места.Ссылка КАК Ссылка
        |ИЗ Справочник.Места КАК Места
        |ГДЕ Места.Зал = &Зал
        |  И Места.Ряд = &Ряд
        |  И Места.НомерМеста = &Номер
        |  И Места.Ссылка <> &ТекущаяСсылка";
    Запрос.УстановитьПараметр("Зал", ТекущийОбъект.Зал);
    Запрос.УстановитьПараметр("Ряд", ТекущийОбъект.Ряд);
    Запрос.УстановитьПараметр("Номер", ТекущийОбъект.НомерМеста);
    Запрос.УстановитьПараметр("ТекущаяСсылка", ТекущийОбъект.Ссылка);
    Если НЕ Запрос.Выполнить().Пустой() Тогда
        Отказ = Истина;
        Сообщить("Это место уже заведено в выбранном зале.");
        Возврат;
    КонецЕсли;

    ЗапросКоличество = Новый Запрос;
    ЗапросКоличество.Текст =
        "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ Справочник.Места КАК Места
        |ГДЕ Места.Зал = &Зал
        |  И Места.Ссылка <> &ТекущаяСсылка";
    ЗапросКоличество.УстановитьПараметр("Зал", ТекущийОбъект.Зал);
    ЗапросКоличество.УстановитьПараметр("ТекущаяСсылка", ТекущийОбъект.Ссылка);
    ВыборкаКоличество = ЗапросКоличество.Выполнить().Выбрать();
    Если ВыборкаКоличество.Следующий() И ВыборкаКоличество.Количество >= ТекущийОбъект.Зал.Вместимость Тогда
        Отказ = Истина;
        Сообщить("Количество заведённых мест не может превышать вместимость зала.");
        Возврат;
    КонецЕсли;
    ТекущийОбъект.Наименование = Строка(ТекущийОбъект.Зал) + ", ряд " + Строка(ТекущийОбъект.Ряд) + ", место " + Строка(ТекущийОбъект.НомерМеста);
КонецПроцедуры

