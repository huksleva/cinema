&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КинотеатрСервер.ОформитьФорму(ЭтаФорма);
    ПодготовитьЕдиницыИзмерения();
    Для Каждого Имя Из СтрРазделить("Код,Наименование,ЕдиницаСсылка", ",") Цикл
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект." + Имя;
    КонецЦикла;
    Элементы.ЕдиницаСсылка.Заголовок = "Единица измерения";
    Если НЕ ЗначениеЗаполнено(Объект.ЕдиницаСсылка) Тогда
        ИмяЕдиницы = Объект.ЕдиницаИзмерения;
        Если НЕ ЗначениеЗаполнено(ИмяЕдиницы) Тогда ИмяЕдиницы = "шт"; КонецЕсли;
        Объект.ЕдиницаСсылка = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ИмяЕдиницы, Истина);
    КонецЕсли;
    ПолеФото = Элементы.Добавить("Фотография", Тип("ПолеФормы"));
    ПолеФото.Вид = ВидПоляФормы.ПолеКартинки;
    ПолеФото.ПутьКДанным = "АдресФото";
    ПолеФото.Заголовок = "Фото";
    ПолеФото.РазмерКартинки = РазмерКартинки.Пропорционально;
    ПолеФото.Ширина = 40;
    ПолеФото.Высота = 15;
    ПолеФото.РастягиватьПоГоризонтали = Ложь;
    ПолеФото.РастягиватьПоВертикали = Ложь;
    Команда = Команды.Добавить("ЗагрузитьФото");
    Команда.Действие = "ЗагрузитьФото";
    Команда.Заголовок = "Загрузить фотографию";
    Кнопка = Элементы.Добавить("КнопкаЗагрузитьФото", Тип("КнопкаФормы"));
    Кнопка.ИмяКоманды = "ЗагрузитьФото";
    ОбъектДанных = РеквизитФормыВЗначение("Объект");
    Если ОбъектДанных.Фото <> Неопределено Тогда
        ФотоДанные = ОбъектДанных.Фото.Получить();
        Если ФотоДанные <> Неопределено Тогда
            ЭтаФорма.АдресФото = ПоместитьВоВременноеХранилище(ФотоДанные, УникальныйИдентификатор);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПодготовитьЕдиницыИзмерения()
    Для Каждого ИмяЕдиницы Из СтрРазделить("шт,кг,л,упак.,порц.", ",") Цикл
        СсылкаЕдиницы = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ИмяЕдиницы, Истина);
        Если НЕ ЗначениеЗаполнено(СсылкаЕдиницы) Тогда
            ЭлементЕдиницы = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
            ЭлементЕдиницы.Наименование = ИмяЕдиницы;
            ЭлементЕдиницы.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФото(Команда)
    НачатьПомещениеФайла(Новый ОписаниеОповещения("ФотоЗагружено", ЭтаФорма), , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    ПодготовитьЕдиницыИзмерения();
    Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ЕдиницаСсылка) И ЗначениеЗаполнено(ТекущийОбъект.ЕдиницаИзмерения) Тогда
        ТекущийОбъект.ЕдиницаСсылка = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ТекущийОбъект.ЕдиницаИзмерения, Истина);
    КонецЕсли;
    Если ТекущийОбъект.Фото <> Неопределено Тогда
        ДанныеФото = ТекущийОбъект.Фото.Получить();
        Если ДанныеФото <> Неопределено Тогда ЭтаФорма.АдресФото = ПоместитьВоВременноеХранилище(ДанныеФото, УникальныйИдентификатор); КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФотоЗагружено(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
    Если Результат Тогда СохранитьФотоНаСервере(Адрес); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьФотоНаСервере(Адрес)
    Данные = ПолучитьИзВременногоХранилища(Адрес);
    Если Данные.Размер() > 5242880 Тогда ВызватьИсключение "Размер фотографии не должен превышать 5 МБ"; КонецЕсли;
    ПроверкаКартинки = Новый Картинка(Данные);
    // Реквизит типа ХранилищеЗначения не входит в данные формы, поэтому фото пишется в объект в ПередЗаписьюНаСервере
    ЭтаФорма.АдресФото = Адрес;
    ФотоИзменено = Истина;
    Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ЕдиницаСсылка) Тогда
        Отказ = Истина;
        Сообщить("Выберите единицу измерения из справочника.");
        Возврат;
    КонецЕсли;
    ТекущийОбъект.ЕдиницаИзмерения = ТекущийОбъект.ЕдиницаСсылка.Наименование;
    Если ФотоИзменено И ЭтоАдресВременногоХранилища(АдресФото) Тогда
        ТекущийОбъект.Фото = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресФото));
        ФотоИзменено = Ложь;
    КонецЕсли;
КонецПроцедуры
