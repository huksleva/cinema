&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Для Каждого Имя Из СтрРазделить("Наименование,Фильм,Зал,ДатаНачала,ДатаОкончания,ЦенаБилета", ",") Цикл
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект." + Имя;
    КонецЦикла;
    Элементы.ДатаОкончания.Доступность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Фильм) Или НЕ ЗначениеЗаполнено(ТекущийОбъект.Зал) Или НЕ ЗначениеЗаполнено(ТекущийОбъект.ДатаНачала) Тогда
        Отказ = Истина;
        Сообщить("Укажите фильм, зал и дату и время начала сеанса.");
        Возврат;
    КонецЕсли;
    Если ТекущийОбъект.ЦенаБилета <= 0 Тогда
        Отказ = Истина;
        Сообщить("Цена билета должна быть больше нуля.");
        Возврат;
    КонецЕсли;
    ФильмОбъект = ТекущийОбъект.Фильм.ПолучитьОбъект();
    Если ФильмОбъект.Продолжительность < 1 Тогда
        Отказ = Истина;
        Сообщить("Сначала задайте корректную длительность фильма.");
        Возврат;
    КонецЕсли;
    ТекущийОбъект.ДатаОкончания = ТекущийОбъект.ДатаНачала + ФильмОбъект.Продолжительность * 60;
    ТекущийОбъект.Наименование = Строка(ТекущийОбъект.Фильм) + " — " + Строка(ТекущийОбъект.Зал) + " — " + Формат(ТекущийОбъект.ДатаНачала, "ДФ=dd.MM.yyyy HH:mm");
КонецПроцедуры
