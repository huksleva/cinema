&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Для Каждого Имя Из СтрРазделить("Наименование,Телефон", ",") Цикл
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Объект." + Имя;
    КонецЦикла;
    Элементы.Наименование.Заголовок = "ФИО";
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Телефон) Тогда
        Возврат;
    КонецЕсли;

    ЦифрыТелефона = "";
    Для Индекс = 1 По СтрДлина(ТекущийОбъект.Телефон) Цикл
        Символ = Сред(ТекущийОбъект.Телефон, Индекс, 1);
        Если СтрНайти("0123456789", Символ) > 0 Тогда
            ЦифрыТелефона = ЦифрыТелефона + Символ;
        ИначеЕсли СтрНайти(" +()-", Символ) = 0 Тогда
            Отказ = Истина;
            Сообщить("Телефон должен содержать только цифры, пробелы, +, скобки и дефисы.");
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Если СтрДлина(ЦифрыТелефона) <> 10 И СтрДлина(ЦифрыТелефона) <> 11 Тогда
        Отказ = Истина;
        Сообщить("Введите номер телефона из 10 или 11 цифр.");
    КонецЕсли;
КонецПроцедуры
